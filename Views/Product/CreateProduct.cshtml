@model Product
@using Microsoft.AspNetCore.Mvc.Rendering;
@{
    ViewData["Title"] = "CreateProduct";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}


<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Ürün Oluşturma</h4>
            <form class="forms-sample" asp-action="CreateProduct" method="post">
                <div class="form-group">
                    <label for="exampleInputName1">Ürün Adı</label>
                    <input type="text" class="form-control" id="exampleInputName1" placeholder="Ürün Adı" asp-for="ProductName">
                </div>
                <div class="form-group">
                    <label for="exampleInputName1">Ürün Fiyatı</label>
                    <input type="text" class="form-control" id="exampleInputName1" placeholder="Fiyat Girin" asp-for="ProductPrice">
                </div>
                <div class="form-group">
                    <label for="exampleInputName1">Ürün Stoğu</label>
                    <input type="text" class="form-control" id="exampleInputName1" placeholder="Stok Girin" asp-for="ProductStock">
                </div>
                <div class="form-group">
                    <label for="exampleInputEmail3">Ürün Durumu</label>
                    <select class="form-control" asp-for="Status">
                        <option value="">Durum Seçiniz</option>
                        <option value="true">Aktif</option>
                        <option value="false">Pasif</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="exampleInputEmail3">Kategori</label>
                    <select class="form-control" asp-for="CategoryId" asp-items="ViewBag.CategoryList">
                        <option value="">Kategori Seçiniz</option>                                           
                    </select>
                </div>

                <button type="submit" class="btn btn-primary mr-2">Oluştur</button>
                <a href="@Url.Action("Index", "Product")" class="btn btn-light">İptal</a>

            </form>
        </div>
    </div>
</div>
