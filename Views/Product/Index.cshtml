 @model List<Product>
@{
    ViewData["Title"] = "Ürünler";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="card-title mb-0">Ürün Yönetimi</h4>
                <a href="/Product/CreateProduct" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus mr-2"></i>Yeni Ürün Ekle
                </a>
            </div>

            <form asp-action="Index" asp-controller="Product" method="get" class="d-flex align-items-center gap-2 mb-4">
                <div class="input-group">
                    <input type="text" name="searchText" value="@ViewBag.SearchText" class="form-control" placeholder="Ürün adı ile ara..." />
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-primary">Ara</button>
                    </div>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="bg-light">
                        <tr>
                            <th>ID</th>
                            <th>Ürün Adı</th>
                            <th>Fiyat</th>
                            <th>Stok</th>
                            <th>Tedarikçi</th>
                            <th>Durum</th>
                            <th class="text-right">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr>
                                <td>@i.ProductId</td>
                                <td class="font-weight-bold text-dark">@i.ProductName</td>
                                <td class="text-success font-weight-bold">@i.ProductPrice.ToString("N2") TL</td>
                                <td>
                                    <span class="badge @(i.ProductStock <= i.MinStockLevel ? "badge-danger" : "badge-light text-dark")">
                                        @i.ProductStock Adet
                                    </span>
                                </td>
                                <td>@(i.Supplier?.CompanyName ?? "Mevcut Değil")</td>
                                <td>
                                    @if (i.Status == true)
                                    {
                                        <label class="badge badge-success badge-pill">Aktif</label>
                                    }
                                    else
                                    {
                                        <label class="badge badge-danger badge-pill">Pasif</label>
                                    }
                                </td>
                                <td class="text-right">
                                    <a href="/Product/UpdateProduct/@i.ProductId" class="btn btn-outline-success btn-sm mr-1">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="/Product/DeleteProduct/@i.ProductId" class="btn btn-outline-danger btn-sm" onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Sayfalama *@
            <div class="d-flex justify-content-center align-items-center gap-2 mt-4 flex-wrap">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-searchtext="@ViewBag.SearchText" class="btn btn-outline-dark btn-sm rounded-pill px-3">← Geri</a>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a asp-action="Index" asp-route-page="@i" asp-route-searchtext="@ViewBag.SearchText" 
                       class="btn btn-sm rounded-pill px-3 @(ViewBag.CurrentPage == i ? "btn-primary" : "btn-outline-primary")">@i</a>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-searchtext="@ViewBag.SearchText" class="btn btn-outline-dark btn-sm rounded-pill px-3">İleri →</a>
                }
            </div>
        </div>
    </div>
</div>

