@model List<StoreFlow.Entity.TodoItem>

<div class="col-md-7 grid-margin stretch-card">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h4 class="card-title">
                <i class="fas fa-tasks mr-2 text-info"></i>
                Görev Takibi
            </h4>
            <div class="add-items d-flex mb-4">
                <input type="text" class="form-control todo-list-input border-right-0" placeholder="Yeni bir görev ekleyin...">
                <button class="add btn btn-info font-weight-bold todo-list-add-btn" id="add-task">Ekle</button>
            </div>
            <div class="list-wrapper" style="max-height: 300px; overflow-y: auto;">
                <ul class="d-flex flex-column-reverse todo-list">
                    @foreach (var todo in Model)
                    {
                        <li class="@(todo.IsCompleted ? "completed" : "") py-2">
                            <div class="form-check m-0">
                                <label class="form-check-label">
                                    <input class="checkbox" type="checkbox" @(todo.IsCompleted ? "checked" : "")>
                                    @todo.Title
                                </label>
                            </div>
                            <i class="remove fa fa-trash-alt text-danger ml-auto" style="cursor: pointer;"></i>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
