@model List<Activity>
<div class="col-md-4 grid-margin stretch-card">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h4 class="card-title">
                <i class="fas fa-history mr-2 text-warning"></i>
                Son Aktiviteler
            </h4>
            <ul class="solid-bullet-list mt-4">
                @foreach (var i in Model)
                {
                    <li class="pb-3 border-bottom mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="font-weight-bold mb-1">@i.Title</h6>
                            <small class="text-muted">@i.ActivityTime</small>
                        </div>
                        <p class="text-muted small mb-0">@i.Description</p>
                    </li>
                }
            </ul>
            <div class="pt-2 text-center">
                <button class="btn btn-link text-warning p-0">Tüm Aktiviteleri Gör</button>
            </div>
        </div>
    </div>
</div>