@model List<StoreFlow.Entity.Project>
@using StoreFlow.Entity.Enum

<div class="col-md-5 grid-margin stretch-card">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h4 class="card-title">
                <i class="fas fa-project-diagram mr-2 text-primary"></i>
                Aktif Projeler
            </h4>
            <div class="table-responsive">
                <table class="table table-borderless">
                    <thead>
                        <tr>
                            <th class="pl-0">Proje / Sorumlu</th>
                            <th class="text-right pr-0">Öncelik</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in Model)
                        {
                            var badgeClass = project.Priority switch
                            {
                                ProjectPriority.High => "badge-danger",
                                ProjectPriority.Medium => "badge-warning",
                                _ => "badge-success"
                            };
                            var priorityText = project.Priority switch
                            {
                                ProjectPriority.High => "Yüksek",
                                ProjectPriority.Medium => "Orta",
                                _ => "Düşük"
                            };
                            <tr>
                                <td class="pl-0 py-3">
                                    <h6 class="font-weight-bold mb-1">@project.ProjectName</h6>
                                    <p class="text-muted small mb-0">@project.AssignedPerson</p>
                                </td>
                                <td class="text-right pr-0 py-3">
                                    <label class="badge @badgeClass badge-pill px-3">@priorityText</label>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
