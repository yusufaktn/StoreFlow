<div class="row grid-margin">
    <div class="col-12">
        <div class="card card-statistics">
            <div class="card-body">
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between">
                    <div class="statistics-item">
                        <p>
                            <i class="icon-sm fa fa-user mr-2"></i>
                            Toplam Müşteri
                        </p>
                        <h2>@ViewBag.CustomerTotalCount</h2>
                        <label class="badge badge-outline-success badge-pill">%2.7 artış</label>
                    </div>
                    <div class="statistics-item">
                        <p>
                            <i class="icon-sm fas fa-hourglass-half mr-2"></i>
                            Toplam Ürün Sayısı
                        </p>
                        <h2>@ViewBag.TotalProductCount</h2>
                        <label class="badge badge-outline-danger badge-pill">%30 azalış</label>
                    </div>
                    <div class="statistics-item">
                        <p>
                            <i class="icon-sm fas fa-cloud-download-alt mr-2"></i>
                            Toplam Kategori
                        </p>
                        <h2>@ViewBag.CategoryTotalCount</h2>
                        <label class="badge badge-outline-success badge-pill">%12 artış</label>
                    </div>
                    <div class="statistics-item">
                        <p>
                            <i class="icon-sm fas fa-check-circle mr-2"></i>
                            Ortalama Müşteri Bakiyesi
                        </p>
                        <h2>@ViewBag.CustomerBalanceAvg</h2>
                        <label class="badge badge-outline-success badge-pill">%57 artış</label>
                    </div>
                    <div class="statistics-item">
                        <p>
                            <i class="icon-sm fas fa-chart-line mr-2"></i>
                            Toplam Sipariş
                        </p>
                        <h2>@ViewBag.TotalOrderCount</h2>
                        <label class="badge badge-outline-success badge-pill">%10 artış</label>
                    </div>
                    <div class="statistics-item">
                        <p>
                            <i class="icon-sm fas fa-circle-notch mr-2"></i>
                            Toplam Para
                        </p>
                        <h2>@ViewBag.TotalMoney</h2>
                        <label class="badge badge-outline-danger badge-pill">%16 azalış</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>