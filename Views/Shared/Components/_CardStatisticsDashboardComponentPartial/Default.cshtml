<div class="row grid-margin">
    <div class="col-12">
        <div class="card card-statistics border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-between">
                    <div class="statistics-item text-center text-md-left">
                        <p class="text-muted mb-2">
                            <i class="icon-sm fas fa-users mr-2 text-primary"></i>
                            Toplam Müşteri
                        </p>
                        <h2 class="font-weight-bold">@ViewBag.CustomerTotalCount</h2>
                    </div>
                    <div class="statistics-item text-center text-md-left">
                        <p class="text-muted mb-2">
                            <i class="icon-sm fas fa-box mr-2 text-success"></i>
                            Toplam Ürün
                        </p>
                        <h2 class="font-weight-bold">@ViewBag.TotalProductCount</h2>
                    </div>
                    <div class="statistics-item text-center text-md-left">
                        <p class="text-muted mb-2">
                            <i class="icon-sm fas fa-layer-group mr-2 text-info"></i>
                            Toplam Kategori
                        </p>
                        <h2 class="font-weight-bold">@ViewBag.CategoryTotalCount</h2>
                    </div>
                    <div class="statistics-item text-center text-md-left">
                        <p class="text-muted mb-2">
                            <i class="icon-sm fas fa-shopping-basket mr-2 text-warning"></i>
                            Toplam Sipariş
                        </p>
                        <h2 class="font-weight-bold">@ViewBag.TotalOrderCount</h2>
                    </div>
                    <div class="statistics-item text-center text-md-left">
                        <p class="text-muted mb-2">
                            <i class="icon-sm fas fa-wallet mr-2 text-danger"></i>
                            Toplam Ciro
                        </p>
                        <h2 class="font-weight-bold">@ViewBag.TotalMoney</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>