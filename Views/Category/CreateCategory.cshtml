
@model Category
@{
    ViewData["Title"] = "CreateCategory";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Kategori Oluşturma</h4>
            <form class="forms-sample" asp-action="CreateCategory"method="post">
                <div class="form-group">
                    <label for="exampleInputName1">Kategori Adı</label>
                    <input type="text" class="form-control" id="exampleInputName1" placeholder="Kategori Adı" asp-for="CategoryName">
                </div>
                <div class="form-group">
                    <label for="exampleInputEmail3">Kategori Durumu</label>
                    <select class="form-control" asp-for="Status">
                        <option value="">Durum Seçiniz</option>
                        <option value="true">Aktif</option>
                        <option value="false">Pasif</option>
                    </select>
                </div>
      
                <button type="submit" class="btn btn-primary mr-2">Oluştur</button>
                <a href="@Url.Action("Index", "Category")" class="btn btn-light">İptal</a>

            </form>
        </div>
    </div>
</div>



