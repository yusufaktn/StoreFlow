@model List<Category>
@{
    ViewData["Title"] = "Kategoriler";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="card-title mb-0">Kategori Yönetimi</h4>
                <a href="/Category/CreateCategory" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus mr-2"></i>Yeni Kategori Ekle
                </a>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="bg-light">
                        <tr>
                            <th>ID</th>
                            <th>Kategori Adı</th>
                            <th>Durum</th>
                            <th class="text-right">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in Model)
                        {
                            <tr>
                                <td>@i.CategoryId</td>
                                <td class="font-weight-bold">@i.CategoryName</td>
                                <td>
                                    @if (i.Status == true)
                                    {
                                        <label class="badge badge-success badge-pill">Aktif</label>
                                    }
                                    else
                                    {
                                        <label class="badge badge-danger badge-pill">Pasif</label>
                                    }
                                </td>
                                <td class="text-right">
                                    <a href="/Category/UpdateCategory/@i.CategoryId" class="btn btn-outline-success btn-sm mr-1">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="/Category/DeleteCategory/@i.CategoryId" class="btn btn-outline-danger btn-sm" onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>