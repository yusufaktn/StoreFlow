@{
    ViewData["Title"] = "İstatistikler";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

@* --- Üst Kartlar (Genel Durum) --- *@
<div class="row">
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-row align-items-center">
                    <i class="mdi mdi-cube-outline icon-lg text-primary"></i>
                    <div class="ml-3">
                        <h6 class="text-muted font-weight-normal">Toplam Ürün</h6>
                        <h3 class="font-weight-bold">@ViewBag.TotalProductCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-row align-items-center">
                    <i class="mdi mdi-account-multiple icon-lg text-success"></i>
                    <div class="ml-3">
                        <h6 class="text-muted font-weight-normal">Toplam Müşteri</h6>
                        <h3 class="font-weight-bold">@ViewBag.TotalCustomerCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-row align-items-center">
                    <i class="mdi mdi-cart-outline icon-lg text-danger"></i>
                    <div class="ml-3">
                        <h6 class="text-muted font-weight-normal">Toplam Sipariş</h6>
                        <h3 class="font-weight-bold">@ViewBag.TotalOrderCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-row align-items-center">
                    <i class="mdi mdi-format-list-bulleted icon-lg text-info"></i>
                    <div class="ml-3">
                        <h6 class="text-muted font-weight-normal">Kategoriler</h6>
                        <h3 class="font-weight-bold">@ViewBag.TotalCategoryCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* --- Finansal Kartlar --- *@
<div class="row">
    <div class="col-md-4 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Toplam Ciro</h4>
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="text-success font-weight-bold">@ViewBag.TotalRevenue TL</h2>
                    <i class="mdi mdi-currency-try icon-md text-success"></i>
                </div>
                <p class="text-muted">Tüm zamanların toplam satışı.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Toplam Gider</h4>
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="text-danger font-weight-bold">@ViewBag.TotalExpense TL</h2>
                    <i class="mdi mdi-trending-down icon-md text-danger"></i>
                </div>
                <p class="text-muted">Tüm harcamaların toplamı.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Net Kar</h4>
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="text-info font-weight-bold">@ViewBag.NetProfit TL</h2>
                    <i class="mdi mdi-cash-multiple icon-md text-info"></i>
                </div>
                <p class="text-muted">Ciro - Gider sonucu.</p>
            </div>
        </div>
    </div>
</div>

@* --- Detaylı Bilgiler --- *@
<div class="row">
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title text-primary"><i class="mdi mdi-information-outline mr-2"></i>Stok ve Ürün Bilgileri</h4>
                <div class="list-group">
                    <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                        <span>Kritik Stok Uyarıları</span>
                        <span class="badge badge-danger badge-pill">@ViewBag.MinProductStockWarning Ürün</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                        <span>En Pahalı Ürün</span>
                        <span class="text-primary font-weight-bold">@ViewBag.MostExpensiveProduct</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                        <span>En Ucuz Ürün</span>
                        <span class="text-primary font-weight-bold">@ViewBag.CheapestProduct</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title text-warning"><i class="mdi mdi-trophy mr-2"></i>En İyi Müşteri</h4>
                <div class="text-center py-3">
                    <div class="display-4 text-warning mb-2">
                        <i class="mdi mdi-account-star"></i>
                    </div>
                    <h3 class="font-weight-bold">@ViewBag.BiggestCustomerName</h3>
                    <p class="text-muted mb-0">Toplam Harcama</p>
                    <h2 class="text-warning font-weight-bold">@ViewBag.BiggestTotalSpent TL</h2>
                </div>
            </div>
        </div>
    </div>
</div>
